# Core
APP_NAME=WishListApp API
DEBUG=False
DOMAIN_NAME=your-domain.com
FRONTEND_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Security
SECRET_KEY=replace_with_at_least_32_random_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_HOURS=1

# Database
POSTGRES_USER=wishlist_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wishlist_db
DATABASE_URL=postgresql+asyncpg://wishlist_user:change_me@db:5432/wishlist_db
DATABASE_URL_SYNC=postgresql+psycopg://wishlist_user:change_me@db:5432/wishlist_db

# SMTP
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=no-reply@your-domain.com
SMTP_PASSWORD=app_password
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=no-reply@your-domain.com

# Scraper tuning (keep logic unchanged)
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_CONNECT_TIMEOUT_SECONDS=6
SCRAPER_READ_TIMEOUT_SECONDS=10
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
